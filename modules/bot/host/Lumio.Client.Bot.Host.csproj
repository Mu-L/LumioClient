<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LumioProduction>false</LumioProduction>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lumio.Client.Bot.Host</RootNamespace>
    <AssemblyName>Lumio.Client.Bot.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lumio.Client.Bot.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <LumioEngineSdkCsproj Condition="'$(LUMIO_ENGINE_SDK_PROJECT)' != ''">$(LUMIO_ENGINE_SDK_PROJECT)</LumioEngineSdkCsproj>
    <LumioArchRoot Condition="'$(LumioArchRoot)' == ''">$(LUMIO_ENGINE_ROOT)</LumioArchRoot>
    <LumioEngineSdkCsproj Condition="'$(LumioEngineSdkCsproj)' == '' AND '$(LumioArchRoot)' != ''">$(LumioArchRoot)/engine/managed/Lumio.Engine.SDK/Lumio.Engine.SDK.csproj</LumioEngineSdkCsproj>
    <LumioNativeLoaderCsproj Condition="'$(LumioArchRoot)' != ''">$(LumioArchRoot)/engine/managed/Lumio.Engine.NativeLoader/Lumio.Engine.NativeLoader.csproj</LumioNativeLoaderCsproj>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LumioEngineSdkCsproj)' != '' AND Exists('$(LumioEngineSdkCsproj)')">
    <DefineConstants>$(DefineConstants);LUMIO_ENGINE_SDK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LumioNativeLoaderCsproj)' != '' AND Exists('$(LumioNativeLoaderCsproj)')">
    <DefineConstants>$(DefineConstants);LUMIO_NATIVE_LOADER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LumioEngineSdkCsproj)' != '' AND Exists('$(LumioEngineSdkCsproj)')">
    <ProjectReference Include="$(LumioEngineSdkCsproj)" />
  </ItemGroup>
  <ItemGroup Condition="'$(LumioNativeLoaderCsproj)' != '' AND Exists('$(LumioNativeLoaderCsproj)')">
    <ProjectReference Include="$(LumioNativeLoaderCsproj)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Lumio.Client.Bot.csproj" />
    <ProjectReference Include="..\..\session\src\Lumio.Client.Session.csproj" />
    <ProjectReference Include="..\..\input\src\Lumio.Client.Input.csproj" />
    <ProjectReference Include="..\..\observability\src\Lumio.Client.Observability.csproj" />
    <ProjectReference Include="..\..\connection\src\Lumio.Client.Connection.csproj" />
    <ProjectReference Include="..\..\handshake\src\Lumio.Client.Handshake.csproj" />
    <ProjectReference Include="..\..\replica\src\Lumio.Client.Replica.csproj" />
    <ProjectReference Include="..\..\prediction\src\Lumio.Client.Prediction.csproj" />
    <ProjectReference Include="..\..\persistence\src\Lumio.Client.Persistence.csproj" />
  </ItemGroup>
</Project>
